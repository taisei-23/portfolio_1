<header class="bg-sky-300 h-16 py-4 px-4 sm:px-6 md:px-10 flex items-center">
  <div class="flex items-center justify-start space-x-2">
    <%= image_tag "logo.jpeg", alt: "App Logo", class: "w-8 h-8 rounded-full" %>
    <span class="text-xl font-bold text-white"><%= link_to "マウントレイル", root_path %></span>
  </div>

  <% if user_signed_in? %>
    <div class="rounded px-4">
      <button data-action="click->sidebar#toggle" class="flex items-center block lg:hidden p-2 rounded-md focus:outline-none hover:bg-gray-100">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
        </svg>
        メニュー
      </button>
    </div>
  <% end %>
</header>
