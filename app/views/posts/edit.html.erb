<br>
<h1 class="text-2xl font-bold mb-6 text-center">投稿の編集</h1>

<div class="items-center">
  <div class="max-w-2xl mx-auto bg-white p-6">
    <%= render 'form', post: @post %>

    <div class="mt-4">
      <%= link_to '戻る', posts_path, class: "bg-gray-300 text-black py-1 px-3 rounded" %>
    </div>

    <div class="mt-4">
      <%= button_to '削除', post_path(@post),
                  method: :delete,
                  data: { turbo_confirm: '本当に削除しますか？' },
                  class: "text-white bg-red-600 py-1 px-3 rounded" %>
    </div>
  </div>
</div>
