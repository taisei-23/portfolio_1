<div class="border rounded p-4 mb-4 shadow-sm hover:shadow-md">
  <div class="flex items-center mb-2 p-2">
    <% if post.user.icon_image.attached? %>
      <%= image_tag url_for(post.user.icon_image), class: "rounded-full mr-2 w-8 h-8", size: "40x40" %>
    <% else %>
      <%= image_tag "default_icon.png", class: "rounded-full mr-2 w-8 h-8", size: "40x40" %>
    <% end %>
    <span class="font-semibold"><%= post.user.name %></span>
    <span class="text-gray-500 text-sm ml-2"><%= post.created_at.strftime("%Y/%m/%d %H:%M") %></span>
  </div>

  <% path = post_path(post) %>

  <%= link_to path, class: "block text-black hover:underline" do %>
    <h2 class="text-lg font-bold mb-1">タイトル: <%= post.title %></h2>
    <p class="mb-2">本文: <%= truncate(post.body, length: 100) %></p>
  <% end %>

  <% if post.image.attached? %>
    <div class="mb-2 opacity-0 -translate-x-10 transition transform duration-1500 ease-out rounded-lg shadow-md transition-all duration-300 ease-out hover:-translate-y-1 hover:scale-105 hover:shadow-xl" data-controller="slide-in">
      <%= image_tag post.image, class: "w-full h-auto rounded max-w-full" %>
    </div>
  <% end %>

  <% if current_user.bookmarks.find_by(post_id: post.id) %>
    <%= render 'posts/unbookmark', post: post %>
  <% else %>
    <%= render 'posts/bookmark', post: post %>
  <% end %>
</div>
