<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "mountrail" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= display_meta_tags(default_meta_tags) %>

    <%= yield :head %>

    <link rel="icon" href="/favicon.png" type="image/png">
    <link rel="apple-touch-icon" href="/favicon.png">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", type: "module", "data-turbo-track": "reload" %>
    <%= turbo_include_tags %>
  </head>

  <body class="min-h-screen">
    <div data-controller="sidebar" class="flex flex-col min-h-screen">
      <%= render "shared/header" %>

      <div class="flex flex-1 overflow-hidden">
        <% if user_signed_in? %>
          <div>
            <%= render "shared/sidebar" %>
          </div>
        <% end %>

        <main class="flex-1 overflow-y-auto bg-white relative flex flex-col">
          <% if flash[:notice].present? %>
            <div class="bg-green-100 text-green-800 p-4 rounded">
              <%= flash[:notice] %>
            </div>
          <% end %>
          <% if flash[:alert].present? %>
            <div class="bg-red-100 text-red-800 p-4 rounded">
              <%= flash[:alert] %>
            </div>
          <% end %>
          <div class="flex-1">
            <%= yield %>
          </div>
        </main>
      </div>

      <%= render "shared/footer" %>
    </div>
  </body>
</html>
