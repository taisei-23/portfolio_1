<div class="min-h-screen flex items-center justify-center">
  <div class="w-full max-w-md bg-white p-8">
    <h2 class="text-2xl font-bold mb-6 text-center">パスワード変更ページ</h2>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>

      <div class="field">
        <%= f.label :password, "新しいパスワード", class: "block mb-1 font-semibold" %>
        <% if @minimum_password_length %>
          <em>(<%= @minimum_password_length %> 文字以上)</em><br />
        <% end %>
        <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "w-80 border border-gray-300 rounded p-2 font-semibold" %>
      </div>
      <br>

      <div class="field">
        <%= f.label :password_confirmation, "パスワード再確認", class: "block mb-1 font-semibold" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-80 border border-gray-300 rounded p-2 font-semibold" %>
      </div>
      <br>

      <div class="actions">
        <%= f.submit "パスワードを変更する", class: "border mb-1 font-semibold rounded p-2 bg-blue-600 text-white" %>
      </div>
    <% end %>
  </div>
</div>
