<div class="min-h-screen flex items-center justify-center">
  <div class="w-full max-w-md bg-white p-8">
    <h2 class="text-2xl font-bold mb-6 text-center">パスワードリセット</h2>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, data: { turbo: false } }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="field">
        <%= f.label :email, "メールアドレス", class: "block mb-1 font-semibold" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-80 border border-gray-300 rounded p-2 font-semibold" %>
      </div><br>

      <div class="actions">
        <%= f.submit "パスワードリセットリンクを送信", class: "border mb-1 font-semibold rounded p-2" %>
      </div>
    <% end %>
  </div>
</div>
